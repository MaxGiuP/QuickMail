    function tableForLanguage() {
        if (languageCode === "de") return german
        if (languageCode === "it") return italian
        return english
    }

    function formatDate(value, pattern) {
        const date = value instanceof Date ? value : new Date(value)
        if (isNaN(date.getTime())) return ""
        return Qt.locale(localeName).toString(date, String(pattern || ""))
    }

    function tr(source, count) {
        const table = tableForLanguage()
        let translated = table[source]
        if (translated === undefined) translated = source
        if (Array.isArray(translated)) {
            const numericCount = Number(count)
            translated = translated[numericCount === 1 ? 0 : 1]
        }
        let result = String(translated)
        if (count !== undefined && count !== null)
            result = result.replace(/%n/g, String(count))
        return result
    }
