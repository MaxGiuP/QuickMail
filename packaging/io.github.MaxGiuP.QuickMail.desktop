[Desktop Entry]
Type=Application
Name=QuickMail
GenericName=Mail, Calendar and Tasks
Comment=Mail, calendars and tasks in one focused workspace
Exec=quickmail -- %u
TryExec=quickmail
Icon=mail-unread-symbolic
Terminal=false
StartupNotify=true
Categories=Office;Email;Calendar;
Keywords=mail;email;calendar;agenda;tasks;todo;gmail;outlook;
MimeType=x-scheme-handler/mailto;
StartupWMClass=io.github.MaxGiuP.QuickMail
SingleMainWindow=true
Actions=Compose;Calendar;Accounts;

[Desktop Action Compose]
Name=New Message
Exec=quickmail mailto:

[Desktop Action Calendar]
Name=Open Calendar & Tasks
Exec=quickmail --calendar

[Desktop Action Accounts]
Name=Manage Accounts
Exec=quickmail --accounts
