[Unit]
Description=QuickMail local mail service
Documentation=https://github.com/MaxGiuP/QuickMail
After=graphical-session.target

[Service]
Type=simple
ExecStart="@BINDIR@/quickmaild" "--socket=%t/quickmail/daemon.sock" "--database=%S/quickmail/mail.db" "--attachment-cache=%C/quickmail/attachments"
Restart=on-failure
RestartSec=2s
RuntimeDirectory=quickmail
RuntimeDirectoryMode=0700
StateDirectory=quickmail
StateDirectoryMode=0700
CacheDirectory=quickmail
CacheDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictRealtime=true
LockPersonality=true

[Install]
WantedBy=default.target
