#!/bin/sh
set -eu

script_dir=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
: "${XDG_RUNTIME_DIR:?quickmail: XDG_RUNTIME_DIR is required for a private daemon socket}"
daemon_socket=$XDG_RUNTIME_DIR/quickmail/daemon.sock
: "${HOME:?quickmail: HOME is required}"
state_home=${XDG_STATE_HOME:-"$HOME/.local/state"}
cache_home=${XDG_CACHE_HOME:-"${HOME:?quickmail: HOME is required when XDG_CACHE_HOME is unset}/.cache"}
daemon_database=$state_home/quickmail/mail.db
attachment_cache=$cache_home/quickmail/attachments

find_qml_dir() {
    for candidate in \
        "${QUICKMAIL_QML_DIR:-}" \
        "$script_dir/../qml" \
        "$script_dir/../share/quickmail/qml" \
        "${XDG_DATA_HOME:-${HOME}/.local/share}/quickmail/qml" \
        "$HOME/.local/share/quickmail/qml" \
        "/usr/local/share/quickmail/qml" \
        "/usr/share/quickmail/qml"
    do
        if [ -n "$candidate" ] && [ -f "$candidate/shell.qml" ]; then
            CDPATH='' cd -- "$candidate" && pwd
            return 0
        fi
    done
    return 1
}

qml_dir=$(find_qml_dir) || {
    echo "quickmail: could not find the installed QML application" >&2
    exit 1
}

find_ctl() {
    for candidate in \
        "$script_dir/quickmailctl" \
        "$(command -v quickmailctl 2>/dev/null || true)" \
        "$script_dir/../target/release/quickmailctl" \
        "$script_dir/../target/debug/quickmailctl"
    do
        if [ -n "$candidate" ] && [ -x "$candidate" ]; then
            printf '%s\n' "$candidate"
            return 0
        fi
    done
    return 1
}

ctl_bin=$(find_ctl || true)

daemon_healthy() {
    [ -n "$ctl_bin" ] \
        && timeout 0.5 "$ctl_bin" --socket "$daemon_socket" --compact ping >/dev/null 2>&1
}

wait_for_daemon() {
    attempts=0
    while [ "$attempts" -lt 40 ]
    do
        if daemon_healthy; then
            return 0
        fi
        attempts=$((attempts + 1))
        sleep 0.05
    done
    return 1
}

ensure_daemon() {
    if daemon_healthy; then
        return 0
    fi

    if command -v systemctl >/dev/null 2>&1; then
        if systemctl --user start quickmaild.service >/dev/null 2>&1; then
            if ! wait_for_daemon; then
                echo "quickmail: systemd started quickmaild, but it is not ready yet" >&2
            fi
            # Never race a successfully started/restarting systemd service with
            # an unmanaged fallback daemon. The UI will continue reconnecting.
            return 0
        fi

        service_state=$(systemctl --user is-active quickmaild.service 2>/dev/null || true)
        case "$service_state" in
            active|activating|reloading)
                wait_for_daemon || true
                return 0
                ;;
        esac
    fi

    daemon_bin=""
    for candidate in \
        "$script_dir/quickmaild" \
        "$(command -v quickmaild 2>/dev/null || true)" \
        "$script_dir/../target/release/quickmaild" \
        "$script_dir/../target/debug/quickmaild"
    do
        if [ -n "$candidate" ] && [ -x "$candidate" ]; then
            daemon_bin=$candidate
            break
        fi
    done
    if [ -n "$daemon_bin" ]; then
        nohup "$daemon_bin" \
            --socket "$daemon_socket" \
            --database "$daemon_database" \
            --attachment-cache "$attachment_cache" \
            </dev/null >/dev/null 2>&1 &
        daemon_pid=$!
        attempts=0
        while [ "$attempts" -lt 40 ]
        do
            if daemon_healthy; then
                return 0
            fi
            if ! kill -0 "$daemon_pid" 2>/dev/null; then
                echo "quickmail: quickmaild exited before creating its socket" >&2
                break
            fi
            attempts=$((attempts + 1))
            sleep 0.05
        done
        if ! daemon_healthy; then
            echo "quickmail: quickmaild did not become ready; the UI will keep reconnecting" >&2
        fi
    else
        echo "quickmail: quickmaild was not found; the UI will keep reconnecting" >&2
    fi
}

if [ "${1:-}" = "--" ]; then
    shift
fi

mailto_uri=""
open_accounts=0
open_calendar=0
case $# in
    0) ;;
    1)
        case "$1" in
            --accounts) open_accounts=1 ;;
            --calendar) open_calendar=1 ;;
            [mM][aA][iI][lL][tT][oO]:*) mailto_uri=$1 ;;
            *)
                echo "usage: quickmail [--accounts | --calendar | mailto:address]" >&2
                exit 2
                ;;
        esac
        ;;
    *)
        echo "usage: quickmail [--accounts | --calendar | mailto:address]" >&2
        exit 2
        ;;
esac

command -v qs >/dev/null 2>&1 || {
    echo "quickmail: Quickshell (qs) is required" >&2
    exit 1
}

ensure_daemon

window_is_mapped() {
    mapped=$(qs ipc -p "$qml_dir" prop get quickMail windowMapped 2>/dev/null || true)
    [ "$mapped" = true ]
}

wait_for_window() {
    attempts=0
    while [ "$attempts" -lt 20 ]
    do
        if window_is_mapped; then
            return 0
        fi
        attempts=$((attempts + 1))
        sleep 0.05
    done
    return 1
}

wait_for_legacy_autosave_grace() {
    instance_pid=$1
    attempts=0
    # Releases before `safeToReplace` autosaved edits after 1.5 seconds but
    # could not report whether that asynchronous write had completed. Give an
    # old process a full additional grace period before its exact PID is ended.
    while [ "$attempts" -lt 60 ]
    do
        if ! kill -0 "$instance_pid" 2>/dev/null; then
            return 0
        fi
        attempts=$((attempts + 1))
        sleep 0.05
    done
    return 0
}

wait_until_safe_to_replace() {
    instance_pid=$1
    attempts=0
    while [ "$attempts" -lt 200 ]
    do
        if ! kill -0 "$instance_pid" 2>/dev/null; then
            return 0
        fi
        if safe=$(qs ipc --pid "$instance_pid" prop get quickMail safeToReplace 2>/dev/null); then
            case "$safe" in
                true) return 0 ;;
                false) ;;
                Property\ not\ found*)
                    # This is an older installed UI. It cannot expose draft
                    # state, so never kill it on the same sub-second path as a
                    # fresh edit.
                    wait_for_legacy_autosave_grace "$instance_pid"
                    return 0
                    ;;
            esac
        fi
        # An IPC failure or unknown response is not proof that a current draft
        # is safe. Retry until the bounded refusal path below.
        attempts=$((attempts + 1))
        sleep 0.05
    done
    echo "quickmail: the hidden UI still has an unsaved draft; refusing to replace it" >&2
    return 1
}

wait_for_instance_exit() {
    instance_pid=$1
    attempts=0
    while [ "$attempts" -lt 100 ]
    do
        if ! kill -0 "$instance_pid" 2>/dev/null; then
            return 0
        fi
        attempts=$((attempts + 1))
        sleep 0.05
    done
    echo "quickmail: the stale UI did not exit in time" >&2
    return 1
}

replace_stale_ui() {
    instance_pid=$1
    # `qs ipc call` can succeed after the compositor has already destroyed the
    # only native window. Stop that exact configuration so --no-duplicate can
    # create a usable replacement below.
    if [ -z "$instance_pid" ]; then
        # `qs list` excludes dead registrations. With no live PID there is no
        # process/config lock left for --no-duplicate to race.
        return 0
    fi
    wait_until_safe_to_replace "$instance_pid" || return 1
    qs kill --pid "$instance_pid" >/dev/null 2>&1 || true
    wait_for_instance_exit "$instance_pid"
}

running_instance_pid() {
    qs list -p "$qml_dir" 2>/dev/null \
        | sed -n 's/^  Process ID: \([0-9][0-9]*\)$/\1/p' \
        | sed -n '1p'
}

if [ "$open_accounts" -eq 1 ]; then
    if qs ipc -p "$qml_dir" call quickMail accounts >/dev/null 2>&1; then
        instance_pid=$(running_instance_pid)
        if wait_for_window; then
            exit 0
        fi
        replace_stale_ui "$instance_pid" || exit 1
    fi
    QUICKMAIL_OPEN_ACCOUNTS=1
    export QUICKMAIL_OPEN_ACCOUNTS
elif [ "$open_calendar" -eq 1 ]; then
    if qs ipc -p "$qml_dir" call quickMail calendar >/dev/null 2>&1; then
        instance_pid=$(running_instance_pid)
        if wait_for_window; then
            exit 0
        fi
        replace_stale_ui "$instance_pid" || exit 1
    fi
    QUICKMAIL_OPEN_CALENDAR=1
    export QUICKMAIL_OPEN_CALENDAR
elif [ -n "$mailto_uri" ]; then
    if qs ipc -p "$qml_dir" call quickMail compose "$mailto_uri" >/dev/null 2>&1; then
        instance_pid=$(running_instance_pid)
        if wait_for_window; then
            exit 0
        fi
        replace_stale_ui "$instance_pid" || exit 1
    fi
    QUICKMAIL_MAILTO_URI=$mailto_uri
    export QUICKMAIL_MAILTO_URI
else
    if qs ipc -p "$qml_dir" call quickMail show >/dev/null 2>&1; then
        instance_pid=$(running_instance_pid)
        if wait_for_window; then
            exit 0
        fi
        replace_stale_ui "$instance_pid" || exit 1
    fi
fi

exec qs --no-duplicate -p "$qml_dir"
